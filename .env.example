# ─────────────────────────────────────────────────
# Samantha OS — Environment Variables
# Copy this to .env and fill in anything you want to override.
# Everything here is optional — Samantha ships with sensible defaults.
# ─────────────────────────────────────────────────

# ── LLM (Ollama, running on host) ────────────────
# Pick any Ollama-pulled model. gemma2:9b is the recommended default
# (good balance of intelligence and speed on Apple Silicon).
# Alternatives: qwen2.5:14b (smarter, slower), llama3.1:8b, mistral:7b
OLLAMA_MODEL=gemma2:9b

# Embedding model for semantic memory search
EMBED_MODEL=nomic-embed-text

# ── Voice (Kokoro TTS) ───────────────────────────
# Voice name. "samantha" is a custom blend (nicole + sky) tuned for the
# project. Other Kokoro voices: af_heart, af_nicole, af_sky, af_bella, ...
KOKORO_VOICE=samantha

# Playback speed. 1.0 = normal, 0.90 = slightly slower (default, warmer),
# 0.75 = noticeably slower, 1.1 = brisk.
KOKORO_SPEED=0.90

# ── Timezone ─────────────────────────────────────
# Used by the reminders/schedule scheduler for local time display
# and by the parser when interpreting phrases like "at 5pm".
TZ=Europe/Stockholm

# ── Optional integrations ────────────────────────

# Microsoft 365 (Outlook + Calendar)
# Register at: https://portal.azure.com → App registrations
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_TENANT_ID=common

# Spotify
# Register at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google credentials are handled via JSON file, not env vars:
# → config/google_credentials.json (download from Google Cloud Console)
