# ─────────────────────────────────────────────────
# Samantha OS — Environment Variables
# Copy this to .env and fill in credentials for optional integrations
# ─────────────────────────────────────────────────

# Microsoft 365 (Outlook + Calendar)
# Register at: https://portal.azure.com → App registrations
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_TENANT_ID=common

# Spotify
# Register at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# TTS Engine: "piper" (lightweight, CPU) or "orpheus" (high-quality, needs Ollama + GPU)
TTS_ENGINE=piper
ORPHEUS_VOICE=tara

# LLM Model: "gemma2:9b" (recommended), "qwen2.5:14b" (smarter, slower)
OLLAMA_MODEL=gemma2:9b

# Embedding model for semantic memory search
EMBED_MODEL=nomic-embed-text

# Google credentials are handled via JSON file:
# → config/google_credentials.json (download from Google Cloud Console)
